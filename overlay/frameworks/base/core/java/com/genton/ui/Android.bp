// AI Native OS AIDL 模块 - ui（会话桥/确认宿主 UI 契约）
// 补建：主线② W4 合入（overlay 有 AIDL 文件但缺 Android.bp）

aidl_interface {
    name: "genton.ui",
    unstable: true,
    srcs: [
        "ConfirmationUiRequest.aidl",
        "IAgentAssistantUi.aidl",
        "IAgentConfirmationHost.aidl",
        "SuggestionCapsuleData.aidl",
    ],
    local_include_dir: ".",
    backend: {
        java: {
            sdk_version: "system_current",
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
