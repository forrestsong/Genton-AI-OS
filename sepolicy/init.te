# AI Native OS - Init 进程策略
# 允许 init 启动 AI Native OS 服务

# ============================================
# 服务启动
# ============================================
allow init genton_service_exec:file { read open execute getattr };
allow init genton_audit_exec:file { read open execute getattr };
allow init genton_policy_exec:file { read open execute getattr };
allow init genton_inference_exec:file { read open execute getattr };
allow init genton_call_exec:file { read open execute getattr };
allow init genton_motion_exec:file { read open execute getattr };

# 域转换
domain_auto_trans(init, genton_service_exec, genton_service)
domain_auto_trans(init, genton_audit_exec, genton_audit)
domain_auto_trans(init, genton_policy_exec, genton_policy)
domain_auto_trans(init, genton_inference_exec, genton_inference)
domain_auto_trans(init, genton_call_exec, genton_call)
domain_auto_trans(init, genton_motion_exec, genton_motion)

# ============================================
# 数据目录创建
# ============================================
allow init genton_data_file_type:dir { create setattr relabelfrom relabelto };
allow init genton_audit_data_file:dir { create_dir_perms relabelfrom relabelto };
allow init genton_policy_data_file:dir { create_dir_perms relabelfrom relabelto };
