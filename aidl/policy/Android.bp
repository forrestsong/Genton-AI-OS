// AI Native OS - Policy AIDL Interface Module
// 策略引擎接口：两阶段求值、令牌签发、确认决策

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.genton.policy",
    
    srcs: [
        "com/genton/policy/*.aidl",
    ],
    
    stability: "vintf",
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    
    imports: [
        "com.genton.agent",  // AgentHandle
    ],
    
    visibility: [
        "//frameworks/base/services/core",
        "//frameworks/base/core/java",
        "//packages/apps/GentonBrain",
        "//packages/apps/SystemUI",  // 路由决策消费
    ],
}
