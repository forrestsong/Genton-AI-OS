// AI Native OS AIDL 模块 - inference（推理路由/端云决策契约）
// 补建：主线② W4 合入（overlay 有 AIDL 文件但缺 Android.bp）

aidl_interface {
    name: "ainative.inference",
    unstable: true,
    srcs: [
        "AttestationReport.aidl",
        "EgressPlan.aidl",
        "IAgentInferenceRouter.aidl",
        "IInferenceCallback.aidl",
        "InferenceCapabilities.aidl",
        "InferenceChunk.aidl",
        "InferenceRequest.aidl",
        "InferenceStats.aidl",
    ],
    local_include_dir: ".",
    backend: {
        java: {
            sdk_version: "system_current",
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
