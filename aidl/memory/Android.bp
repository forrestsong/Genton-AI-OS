// AI Native OS - Memory AIDL Interface Module
// 记忆服务接口：三层分区、provenance、遗忘

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.ainative.memory",
    
    srcs: [
        "com/ainative/memory/*.aidl",
    ],
    
    stability: "vintf",
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    
    imports: [
        "com.ainative.agent",  // AgentHandle
    ],
    
    visibility: [
        "//frameworks/base/services/core",
        "//packages/apps/AINativeBrain",
    ],
}
