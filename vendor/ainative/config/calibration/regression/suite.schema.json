{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ainative.os/schemas/calibration-regression-suite.schema.json",
  "title": "AI Native OS 校准回归样本集（CalibrationRegressionSuite）",
  "description": "F4.2 per-机型黄金集。每个样本集绑定一份 F4.1 机型校准档案（profileRef），用冻结的期望值（assertion.value）与来源路径（assertion.source）记录该机型的校准基线；校验入口 tools/calibration_collect.py regression-validate。与 H4.1 真机矩阵共用：H4.1 运行器读取 cases[] 执行，结果回写 status。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suiteId",
    "schemaVersion",
    "profileRef",
    "status",
    "cases"
  ],
  "properties": {
    "suiteId": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,48}$",
      "description": "样本集 ID，建议 calib_regression_<profileId>"
    },
    "schemaVersion": { "type": "string", "const": "1.0" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "profileRef": {
      "type": "string",
      "description": "相对本目录的机型档案路径，如 ../profiles/sm8550_p0.json"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "pending_device_run", "verified"],
      "description": "样本集状态：draft 草稿 / pending_device_run 待真机执行 / verified 真机执行并复核通过（由 H4.1 运行器回写）"
    },
    "runnerRef": {
      "type": "string",
      "description": "执行该样本集的运行器（H4.1 真机矩阵基线），未就绪时留空"
    },
    "notes": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "category", "title", "priority", "assertion"],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[a-z0-9_.]{3,64}$",
          "description": "用例 ID，建议 <category>.<维度>，如 replay.hybrid.cross_device"
        },
        "category": {
          "type": "string",
          "enum": ["coordinate", "replay", "timing", "downsample", "dmi_gate", "s7_gate"],
          "description": "coordinate 坐标映射 / replay 宏重放 / timing 时序 / downsample 降载 / dmi_gate DMI 可用性门控 / s7_gate 姿态档位与手势门控"
        },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "onUnsupported": {
          "type": "string",
          "enum": ["fail", "skip"],
          "default": "fail",
          "description": "当前机型不支持该能力时的期望处置：skip 记为跳过（不得记为失败），fail 记为失败。门控类用例（s7_gate / dmi_gate）取值为 false 时必须为 skip"
        },
        "params": {
          "type": "object",
          "description": "用例参数（类别相关，取值均为标量）；各类别必需键由校验工具强制",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "assertion": { "$ref": "#/definitions/assertion" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "op", "value", "source"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "roundTripTolerancePx",
            "successRate",
            "p95LatencyMs",
            "captureDownsampleFactor",
            "injectionFrameRateCapFps",
            "dmiBridgeState",
            "motionTierEnabled",
            "gestureSupported",
            "aonIsland"
          ]
        },
        "op": { "type": "string", "enum": ["ge", "le", "eq", "in"] },
        "value": {
          "type": ["number", "string", "boolean", "array"],
          "description": "冻结的期望值（黄金值）。须可由 source 指向的档案字段复算得出"
        },
        "source": {
          "type": "string",
          "description": "期望值来源：档案字段路径（如 macro.successRateTarget.crossDevice）或 dmiAvailability.registryRef#<toolName>"
        }
      }
    }
  }
}
