// AI Native OS - Inference AIDL Interface Module
// 推理路由接口：端云决策、预算管理、用量计量

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.genton.inference",
    
    srcs: [
        "com/genton/inference/*.aidl",
    ],
    
    stability: "vintf",
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    
    imports: [
        "com.genton.agent",   // AgentHandle
        "com.genton.policy",  // CapabilityToken
        "com.genton.audit",   // 计量审计
    ],
    
    visibility: [
        "//frameworks/base/services/core",
        "//packages/apps/GentonBrain",
        "//vendor/genton/ai-runtime",  // AI Runtime 实现
    ],
}
