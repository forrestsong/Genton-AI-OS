// AI Native OS - Context AIDL Interface Module
// 上下文服务接口：ContextFrame、热缓存、TOP_UI_SUMMARY

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.genton.context",
    
    srcs: [
        "com/genton/context/*.aidl",
    ],
    
    stability: "vintf",
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    
    imports: [
        "com.genton.perception",  // UiSnapshot
        "com.genton.events",      // SystemEvent
        "com.genton.agent",       // AgentHandle
    ],
    
    visibility: [
        "//frameworks/base/services/core",
        "//packages/apps/GentonBrain",
    ],
}
