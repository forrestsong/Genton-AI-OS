// AI Native OS - UI AIDL Interface Module
// UI 契约接口：确认宿主、会话桥、上下文泡泡

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.genton.ui",
    
    srcs: [
        "com/genton/ui/*.aidl",
    ],
    
    stability: "vintf",
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    
    imports: [
        "com.genton.action",    // ActionRequest
        "com.genton.agent",     // AgentHandle
        "com.genton.context",   // ContextFrame
    ],
    
    visibility: [
        "//frameworks/base/services/core",
        "//frameworks/base/core/java",
        "//packages/apps/GentonBrain",
        "//packages/apps/SystemUI",  // 会话桥宿主
    ],
}
