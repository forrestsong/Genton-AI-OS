<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Native OS - 特权应用权限清单
  定义大脑 App (com.ainative.brain) 的系统权限
-->
<permissions>
    <privapp-permissions package="com.ainative.brain">
        
        <!-- ============================================ -->
        <!-- 感知服务权限 -->
        <!-- ============================================ -->
        
        <!-- UI 树捕获 -->
        <permission name="android.permission.DUMP" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        
        <!-- 屏幕捕获 -->
        <permission name="android.permission.READ_FRAME_BUFFER" />
        <permission name="android.permission.CAPTURE_VIDEO_OUTPUT" />
        
        <!-- 通知访问 -->
        <permission name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
        <permission name="android.permission.ACCESS_NOTIFICATIONS" />
        
        <!-- ============================================ -->
        <!-- 动作执行权限 -->
        <!-- ============================================ -->
        
        <!-- Accessibility 服务 -->
        <permission name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
        
        <!-- Activity 启动 -->
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
        
        <!-- 输入注入 -->
        <permission name="android.permission.INJECT_EVENTS" />
        
        <!-- 设备控制 -->
        <permission name="android.permission.WRITE_SETTINGS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        
        <!-- 剪贴板访问 -->
        <permission name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
        
        <!-- ============================================ -->
        <!-- Agent 运行时权限 -->
        <!-- ============================================ -->
        
        <!-- 会话管理 -->
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL" />
        
        <!-- 后台运行 -->
        <permission name="android.permission.SYSTEM_ALERT_WINDOW" />
        <permission name="android.permission.FOREGROUND_SERVICE" />
        
        <!-- ============================================ -->
        <!-- 记忆服务权限 -->
        <!-- ============================================ -->
        
        <!-- 存储访问 -->
        <permission name="android.permission.READ_EXTERNAL_STORAGE" />
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE" />
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        
        <!-- ============================================ -->
        <!-- 事件流权限 -->
        <!-- ============================================ -->
        
        <!-- 电池统计 -->
        <permission name="android.permission.BATTERY_STATS" />
        <permission name="android.permission.DEVICE_POWER" />
        
        <!-- 网络状态 -->
        <permission name="android.permission.ACCESS_NETWORK_STATE" />
        <permission name="android.permission.CHANGE_NETWORK_STATE" />
        
        <!-- 位置信息 -->
        <permission name="android.permission.ACCESS_FINE_LOCATION" />
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" />
        
        <!-- ============================================ -->
        <!-- 推理路由权限 -->
        <!-- ============================================ -->
        
        <!-- 网络访问（云端推理） -->
        <permission name="android.permission.INTERNET" />
        <permission name="android.permission.ACCESS_WIFI_STATE" />
        
        <!-- NPU 访问 -->
        <permission name="android.permission.CAMERA" />  <!-- 某些 NPU 需要 -->
        
        <!-- ============================================ -->
        <!-- 通话门控权限 -->
        <!-- ============================================ -->
        
        <!-- Telecom 服务 -->
        <permission name="android.permission.CALL_PHONE" />
        <permission name="android.permission.READ_PHONE_STATE" />
        <permission name="android.permission.READ_CALL_LOG" />
        <permission name="android.permission.PROCESS_OUTGOING_CALLS" />
        <permission name="android.permission.ANSWER_PHONE_CALLS" />
        
        <!-- ============================================ -->
        <!-- 姿态交互权限 -->
        <!-- ============================================ -->
        
        <!-- 传感器访问 -->
        <permission name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
        <permission name="android.permission.BODY_SENSORS" />
        
        <!-- ============================================ -->
        <!-- 审计与调试 -->
        <!-- ============================================ -->
        
        <!-- 日志访问 -->
        <permission name="android.permission.READ_LOGS" />
        
        <!-- 包管理 -->
        <permission name="android.permission.QUERY_ALL_PACKAGES" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        
        <!-- ============================================ -->
        <!-- 系统级权限 -->
        <!-- ============================================ -->
        
        <!-- 状态栏控制 -->
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.EXPAND_STATUS_BAR" />
        
        <!-- 唤醒锁 -->
        <permission name="android.permission.WAKE_LOCK" />
        
        <!-- 广播保护 -->
        <permission name="android.permission.BROADCAST_STICKY" />
        
        <!-- 系统设置 -->
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        
    </privapp-permissions>
</permissions>
