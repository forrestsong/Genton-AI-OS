// AI Native Brain Application
// Agent 大脑特权应用

android_app {
    name: "AINativeBrain",
    
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    
    resource_dirs: ["res"],
    
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    
    static_libs: [
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        // AI Native OS AIDL 模块（com.ainative.* 生成类）
        "ainative.core",
        "ainative.perception",
        "ainative.action",
        "ainative.agent",
        "ainative.audit",
        "ainative.memory",
        "ainative.policy",
        "ainative.events",
        "ainative.context",
        "ainative.execution",
        "ainative.inference",
        "ainative.assets",
        "ainative.macro",
        "ainative.decision",
        "ainative.ui",
        "ainative.call",
        "ainative.motion",
        "ainative.sandbox",
    ],
    
    // 依赖 framework（包含 com.ainative.* AIDL 接口）
    libs: [
        "framework",
    ],
    
    optimize: {
        enabled: false,
    },
    
    dex_preopt: {
        enabled: false,
    },
    
    owner: "ainative",
    
    required: [
        "permissions_com.ainative.brain.xml",
    ],
}

// 权限配置
prebuilt_etc {
    name: "permissions_com.ainative.brain.xml",
    src: "permissions_com.ainative.brain.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
