<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Native OS Privileged App Permissions Whitelist
  
  定义哪些特权应用可以使用哪些 AI Native 权限。
  
  规则:
  1. 仅平台签名应用可被授予 AI Native 权限
  2. 应用必须安装在 /system/priv-app 目录
  3. 遵循最小权限原则 (Principle of Least Privilege)
  
  版本: v1.0
  日期: 2026-09-05
  依据: WBS A1.4 权限清单落地
-->
<permissions>
    
    <!-- ========================================
         大脑特权应用 (Agent Brain)
         完整权限集 - 核心 AI 编排引擎
         ======================================== -->
    <privapp-permissions package="com.genton.brain">
        <!-- 感知层权限 -->
        <permission name="com.genton.permission.BIND_UI_TREE_SERVICE"/>
        <permission name="com.genton.permission.BIND_SCREEN_SERVICE"/>
        <permission name="com.genton.permission.MANAGE_NOTIFICATIONS"/>
        
        <!-- 事件流权限 -->
        <permission name="com.genton.permission.SUBSCRIBE_EVENTS"/>
        
        <!-- 执行层权限 -->
        <permission name="com.genton.permission.BIND_ACTION_SERVICE"/>
        
        <!-- 运行时权限 -->
        <permission name="com.genton.permission.BIND_AGENT_RUNTIME"/>
        
        <!-- 记忆与审计权限 -->
        <permission name="com.genton.permission.BIND_MEMORY_SERVICE"/>
        <permission name="com.genton.permission.BIND_AUDIT_SERVICE"/>
        
        <!-- 语义与上下文权限 -->
        <permission name="com.genton.permission.QUERY_ENTITY"/>
        <permission name="com.genton.permission.BIND_CONTEXT_SERVICE"/>
        
        <!-- 策略与资产权限 -->
        <permission name="com.genton.permission.BIND_POLICY_ENGINE"/>
        <permission name="com.genton.permission.BIND_ASSET_LIBRARY"/>
        
        <!-- 推理与沙箱权限 -->
        <permission name="com.genton.permission.BIND_INFERENCE_ROUTER"/>
        <permission name="com.genton.permission.MANAGE_SANDBOX"/>
        
        <!-- 通话与姿态权限 -->
        <permission name="com.genton.permission.BIND_CALL_GATE"/>
        <permission name="com.genton.permission.BIND_MOTION_HUB"/>
        
        <!-- UI 层权限 -->
        <permission name="com.genton.permission.AGENT_SESSION_SERVICE"/>
    </privapp-permissions>

    <!-- ========================================
         SystemUI (系统界面)
         受限权限集 - 仅 UI 交互相关
         ======================================== -->
    <privapp-permissions package="com.android.systemui">
        <!-- UI 命令通道 - SystemUI 绑定大脑 -->
        <permission name="com.genton.permission.BIND_AGENT_UI"/>
        
        <!-- 上下文订阅 - 用于会话 UI 状态同步 -->
        <permission name="com.genton.permission.BIND_CONTEXT_SERVICE"/>
        
        <!-- 审计查询 - 用于仪表盘展示 -->
        <permission name="com.genton.permission.BIND_AUDIT_SERVICE"/>
    </privapp-permissions>

    <!-- ========================================
         设置应用 (Settings)
         受限权限集 - 仅配置和审计相关
         ======================================== -->
    <privapp-permissions package="com.android.settings">
        <!-- 审计查询 - 用于隐私/审计设置页面 -->
        <permission name="com.genton.permission.BIND_AUDIT_SERVICE"/>
        
        <!-- 策略引擎 - 用于策略配置界面 -->
        <permission name="com.genton.permission.BIND_POLICY_ENGINE"/>
        
        <!-- Agent 运行时 - 用于 Agent 管理界面 -->
        <permission name="com.genton.permission.BIND_AGENT_RUNTIME"/>
    </privapp-permissions>

    <!-- ========================================
         Shell (调试工具)
         受限权限集 - 仅开发/调试场景
         ======================================== -->
    <privapp-permissions package="com.android.shell">
        <!-- 审计查询 - dumpsys 输出 -->
        <permission name="com.genton.permission.BIND_AUDIT_SERVICE"/>
        
        <!-- Agent 运行时查询 - dumpsys 输出 -->
        <permission name="com.genton.permission.BIND_AGENT_RUNTIME"/>
        
        <!-- 策略引擎查询 - dumpsys 输出 -->
        <permission name="com.genton.permission.BIND_POLICY_ENGINE"/>
    </privapp-permissions>

    <!-- ========================================
         第三方 Agent 沙箱宿主 (未来扩展)
         极度受限权限集 - 仅网关访问
         
         注意: 第三方 Agent 不直接访问系统服务，
         通过沙箱网关间接调用，权限由策略引擎动态控制
         ======================================== -->
    <!-- 
    <privapp-permissions package="com.genton.sandbox">
        <permission name="com.genton.permission.MANAGE_SANDBOX"/>
        <permission name="com.genton.permission.BIND_POLICY_ENGINE"/>
    </privapp-permissions>
    -->

</permissions>
