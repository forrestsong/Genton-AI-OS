# AI Native OS - 文件上下文定义
# 将文件路径映射到 SELinux 类型

# ============================================
# 系统服务可执行文件
# ============================================
/system/bin/genton_service          u:object_r:genton_service_exec:s0
/system/bin/genton_audit            u:object_r:genton_audit_exec:s0
/system/bin/genton_policy           u:object_r:genton_policy_exec:s0
/system/bin/genton_inference        u:object_r:genton_inference_exec:s0
/system/bin/genton_call             u:object_r:genton_call_exec:s0
/system/bin/genton_motion           u:object_r:genton_motion_exec:s0

# ============================================
# 数据目录
# ============================================
# 审计日志（哈希链）
/data/genton/audit(/.*)?            u:object_r:genton_audit_data_file:s0

# 策略缓存
/data/genton/policy(/.*)?           u:object_r:genton_policy_data_file:s0

# 大脑 App 数据
/data/user/0/com.genton.brain(/.*)?     u:object_r:genton_brain_app_data_file:s0
/data/user_de/0/com.genton.brain(/.*)? u:object_r:genton_brain_app_data_file:s0

# 记忆服务数据（三层分区）
/data/genton/memory(/.*)?           u:object_r:system_data_file:s0

# 上下文热缓存
/data/genton/context(/.*)?          u:object_r:system_data_file:s0

# ============================================
# 配置文件（只读）
# ============================================
# DSL 策略包
/vendor/genton/policy(/.*)?         u:object_r:system_file:s0

# 动作注册表
/vendor/genton/registry(/.*)?       u:object_r:system_file:s0

# AI 模型文件
/vendor/genton/models(/.*)?         u:object_r:vendor_file:s0

# Skill/DMI/Macro 资产
/vendor/genton/assets(/.*)?         u:object_r:system_file:s0

# ============================================
# SystemUI 扩展
# ============================================
/system/priv-app/SystemUI/genton(/.*)?  u:object_r:system_file:s0

# ============================================
# 设备节点
# ============================================
# NPU 设备（推理加速）
/dev/npu                              u:object_r:gpu_device:s0
