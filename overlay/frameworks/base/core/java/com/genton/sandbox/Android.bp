// AI Native OS AIDL 模块 - sandbox（沙箱执行契约）
// 补建：主线② W4 合入（AIDL 源：aidl/com/genton/sandbox，overlay 此前缺失）

aidl_interface {
    name: "genton.sandbox",
    unstable: true,
    srcs: [
        "GatewayRequest.aidl",
        "GatewayResponse.aidl",
        "IAgentSandboxGateway.aidl",
        "IAgentSandboxHostEvents.aidl",
        "IAgentSandboxManager.aidl",
        "ISandboxedAgent.aidl",
        "SandboxHandle.aidl",
        "SandboxManifest.aidl",
        "SandboxSessionContext.aidl",
        "SandboxStatus.aidl",
        "SandboxToolCall.aidl",
        "SandboxUserTurn.aidl",
        "ToolResultEnvelope.aidl",
    ],
    local_include_dir: ".",
    backend: {
        java: {
            sdk_version: "system_current",
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
