<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Native OS System Configuration
  
  系统级配置，包括：
  1. 白名单特权应用
  2. 系统库列表
  3. 隐藏 API 白名单
  
  版本: v1.0
  日期: 2026-09-05
  依据: WBS A1.4 权限清单落地
-->
<config>

    <!-- ========================================
         特权应用白名单
         允许安装在 /system/priv-app 的应用
         ======================================== -->
    
    <!-- Agent 大脑特权应用 -->
    <privapp-permissions package="com.genton.brain" />
    
    <!-- SystemUI 已在 AOSP 默认白名单中，此处无需重复 -->
    
    <!-- Settings 已在 AOSP 默认白名单中，此处无需重复 -->

    <!-- ========================================
         AI Native 系统库
         允许被应用链接的系统共享库
         ======================================== -->
    
    <!-- AI Native AIDL 库 - 供大脑应用使用 -->
    <library name="com.genton.perception"
        file="/system/framework/com.genton.perception.jar" />
    
    <library name="com.genton.action"
        file="/system/framework/com.genton.action.jar" />
    
    <library name="com.genton.agent"
        file="/system/framework/com.genton.agent.jar" />
    
    <library name="com.genton.memory"
        file="/system/framework/com.genton.memory.jar" />
    
    <library name="com.genton.audit"
        file="/system/framework/com.genton.audit.jar" />
    
    <library name="com.genton.semantics"
        file="/system/framework/com.genton.semantics.jar" />
    
    <library name="com.genton.events"
        file="/system/framework/com.genton.events.jar" />
    
    <library name="com.genton.context"
        file="/system/framework/com.genton.context.jar" />
    
    <library name="com.genton.policy"
        file="/system/framework/com.genton.policy.jar" />
    
    <library name="com.genton.assets"
        file="/system/framework/com.genton.assets.jar" />
    
    <library name="com.genton.ui"
        file="/system/framework/com.genton.ui.jar" />
    
    <library name="com.genton.inference"
        file="/system/framework/com.genton.inference.jar" />
    
    <library name="com.genton.sandbox"
        file="/system/framework/com.genton.sandbox.jar" />
    
    <library name="com.genton.call"
        file="/system/framework/com.genton.call.jar" />

    <!-- ========================================
         隐藏 API 白名单 (Hidden API Whitelist)
         允许大脑应用访问的系统隐藏 API
         ======================================== -->
    
    <!-- 大脑应用可访问所有 AI Native 系统 API -->
    <hidden-api-whitelist package="com.genton.brain">
        <class name="com.android.server.genton.*" />
        <class name="com.genton.*" />
    </hidden-api-whitelist>

    <!-- ========================================
         系统服务绑定白名单
         允许非系统进程绑定的系统服务
         ======================================== -->
    
    <!-- AI Native 服务允许大脑绑定 -->
    <allow-in-power-save package="com.genton.brain" />
    <allow-in-data-usage-save package="com.genton.brain" />

</config>
