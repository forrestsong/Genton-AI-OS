// Asset Library AIDL Interface
// 资产库接口定义

aidl_interface {
    name: "ainative.assets",
    unstable: true,
    
    srcs: [
        "*.aidl",
    ],
    
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
