# AI Native OS - SELinux 策略定义
# 系统服务核心域

# ============================================
# ainative_service - 系统服务基础域
# ============================================
type ainative_service, domain;
type ainative_service_exec, exec_type, file_type;

# 允许从 system_server 启动
init_daemon_domain(ainative_service)

# 基本权限
allow ainative_service self:capability {
    dac_read_search
    dac_override
    setuid
    setgid
};

# Binder 通信
binder_use(ainative_service)
binder_call(ainative_service, system_server)
allow ainative_service system_server:binder { call transfer };

# ServiceManager 注册
allow ainative_service servicemanager:binder { call transfer };
allow ainative_service service_manager_type:service_manager { add find };

# 文件系统访问
allow ainative_service system_data_file:dir { create_dir_perms rw_dir_perms };
allow ainative_service system_data_file:file { create_file_perms rw_file_perms };

# 日志权限
allow ainative_service kmsg_device:chr_file w_file_perms;
userdebug_or_eng(`
  allow ainative_service su:unix_stream_socket connectto;
')

# ============================================
# ainative_brain_app - 大脑特权 App
# ============================================
type ainative_brain_app, domain;
type ainative_brain_app_data_file, file_type, data_file_type;

# 从 platform_app 继承基本权限
app_domain(ainative_brain_app)

# 标记为特权应用
priv_app(ainative_brain_app)

# Binder 通信
binder_call(ainative_brain_app, system_server)
binder_call(ainative_brain_app, ainative_service)

# 访问 AI Native OS 系统服务
allow ainative_brain_app ainative_service_type:service_manager find;
allow ainative_brain_app ainative_service:binder { call transfer };

# 数据目录权限
allow ainative_brain_app ainative_brain_app_data_file:dir create_dir_perms;
allow ainative_brain_app ainative_brain_app_data_file:file create_file_perms;

# 网络访问（云端推理）
allow ainative_brain_app self:tcp_socket create_stream_socket_perms;
allow ainative_brain_app node_type:node { tcp_recv tcp_send };
allow ainative_brain_app port_type:tcp_socket { name_connect };

# 传感器访问（MotionHub）
allow ainative_brain_app sensorservice_service:service_manager find;
allow ainative_brain_app system_server:binder call;

# ============================================
# ainative_audit - 审计服务域
# ============================================
type ainative_audit, domain;
type ainative_audit_exec, exec_type, file_type;
type ainative_audit_data_file, file_type, data_file_type;

init_daemon_domain(ainative_audit)

# Binder 通信
binder_use(ainative_audit)
binder_call(ainative_audit, system_server)

# 审计日志写入
allow ainative_audit ainative_audit_data_file:dir create_dir_perms;
allow ainative_audit ainative_audit_data_file:file create_file_perms;

# 哈希链验证
allow ainative_audit self:capability { sys_admin };

# ============================================
# ainative_policy - 策略引擎域
# ============================================
type ainative_policy, domain;
type ainative_policy_exec, exec_type, file_type;
type ainative_policy_data_file, file_type, data_file_type;

init_daemon_domain(ainative_policy)

# Binder 通信
binder_use(ainative_policy)
binder_call(ainative_policy, system_server)
binder_call(ainative_policy, ainative_brain_app)

# DSL 规则目录访问
allow ainative_policy system_file:dir r_dir_perms;
allow ainative_policy system_file:file r_file_perms;

# 策略决策日志
allow ainative_policy ainative_policy_data_file:dir create_dir_perms;
allow ainative_policy ainative_policy_data_file:file create_file_perms;

# ============================================
# ainative_inference - 推理路由域
# ============================================
type ainative_inference, domain;
type ainative_inference_exec, exec_type, file_type;

init_daemon_domain(ainative_inference)

# Binder 通信
binder_use(ainative_inference)
binder_call(ainative_inference, system_server)

# AI Runtime 访问
allow ainative_inference self:capability { sys_nice };  # 调整 NPU 优先级
allow ainative_inference gpu_device:chr_file rw_file_perms;  # NPU 设备
allow ainative_inference ion_device:chr_file rw_file_perms;  # 内存映射

# 模型文件访问
allow ainative_inference vendor_file:dir r_dir_perms;
allow ainative_inference vendor_file:file r_file_perms;

# ============================================
# ainative_call - 通话门控域
# ============================================
type ainative_call, domain;
type ainative_call_exec, exec_type, file_type;

init_daemon_domain(ainative_call)

# Binder 通信
binder_use(ainative_call)
binder_call(ainative_call, system_server)
binder_call(ainative_call, radio)  # Telephony 集成

# Telecom 服务访问
allow ainative_call telecom_service:service_manager find;
allow ainative_call radio:binder call;

# 紧急号码白名单
allow ainative_call system_file:file r_file_perms;

# ============================================
# ainative_motion - 姿态交互域
# ============================================
type ainative_motion, domain;
type ainative_motion_exec, exec_type, file_type;

init_daemon_domain(ainative_motion)

# Binder 通信
binder_use(ainative_motion)
binder_call(ainative_motion, system_server)

# 传感器访问
allow ainative_motion sensorservice_service:service_manager find;
allow ainative_motion system_server:binder call;
allow ainative_motion sensor_device:chr_file rw_file_perms;

# 功耗统计
allow ainative_motion sysfs_batteryinfo:dir r_dir_perms;
allow ainative_motion sysfs_batteryinfo:file r_file_perms;

# ============================================
# 服务类型定义（所有 AI Native OS 服务）
# ============================================
type ainative_service_type, service_manager_type;

# 14 个系统服务
type ainative_perception_service, ainative_service_type, service_manager_type;
type ainative_action_service, ainative_service_type, service_manager_type;
type ainative_agent_service, ainative_service_type, service_manager_type;
type ainative_memory_service, ainative_service_type, service_manager_type;
type ainative_audit_service, ainative_service_type, service_manager_type;
type ainative_semantics_service, ainative_service_type, service_manager_type;
type ainative_events_service, ainative_service_type, service_manager_type;
type ainative_context_service, ainative_service_type, service_manager_type;
type ainative_policy_service, ainative_service_type, service_manager_type;
type ainative_assets_service, ainative_service_type, service_manager_type;
type ainative_ui_service, ainative_service_type, service_manager_type;
type ainative_inference_service, ainative_service_type, service_manager_type;
type ainative_sandbox_service, ainative_service_type, service_manager_type;
type ainative_call_service, ainative_service_type, service_manager_type;
type ainative_motion_service, ainative_service_type, service_manager_type;

# ============================================
# 禁止第三方应用访问
# ============================================
neverallow { appdomain -ainative_brain_app -system_app -priv_app } ainative_service_type:service_manager find;
neverallow { appdomain -ainative_brain_app -system_app -priv_app } ainative_service:binder call;

# 禁止 shell 访问（仅调试构建允许）
neverallow shell ainative_service_type:service_manager { add find };
userdebug_or_eng(`
  allow shell ainative_service_type:service_manager find;
')

# ============================================
# 数据保护
# ============================================
# 禁止非特权域读取审计日志
neverallow { domain -ainative_audit -system_server } ainative_audit_data_file:file read;

# 禁止非策略引擎修改 DSL 规则
neverallow { domain -ainative_policy -init } ainative_policy_data_file:file write;
