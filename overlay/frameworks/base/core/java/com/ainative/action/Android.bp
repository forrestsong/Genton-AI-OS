// AI Native OS Action Execution AIDL Interface
aidl_interface {
    name: "ainative.action",
    
    // 首次构建，不需要版本控制
    unstable: true,
    
    srcs: [
        "IAgentActionService.aidl",
        "IAgentActionCallback.aidl",
        "ActionRequest.aidl",
        "ActionExecutionStatus.aidl",
        "ActionResult.aidl",
        "ActionInfo.aidl",
    ],
    
    local_include_dir: ".",
    
    backend: {
        java: {
            sdk_version: "system_current",
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}