// AI Native OS AIDL 模块 - execution（动作执行契约）
// 补建：主线② W4 合入（overlay 有 AIDL 文件但缺 Android.bp）

aidl_interface {
    name: "ainative.execution",
    unstable: true,
    imports: [
        "ainative.policy",
    ],
    srcs: [
        "ActionExecutionStatus.aidl",
        "ActionInfo.aidl",
        "ActionRequest.aidl",
        "IActionCallback.aidl",
        "IActionExecutionService.aidl",
        "TaintSource.aidl",
        "TaintViolation.aidl",
    ],
    local_include_dir: ".",
    backend: {
        java: {
            sdk_version: "system_current",
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
