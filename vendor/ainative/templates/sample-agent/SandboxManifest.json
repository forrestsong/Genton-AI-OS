{
  "$schema": "https://ainative.os/schemas/sandbox-manifest.schema.json",
  "sandbox_agent": {
    "id": "com.example.notepadmate.agent",
    "name": "便签小助手",
    "developer": "com.example",
    "version": 1,
    "signature_ref": "sha256-<PLACEHOLDER_REPLACE_WITH_APK_SIGNATURE_FINGERPRINT>",
    "sandboxed": true,
    "model": {
      "endpoints": [
        {
          "domain": "api.example.com",
          "protocol": "https",
          "attestation": "not_required"
        }
      ]
    },
    "requested_capabilities": [
      {
        "capability": "agent.ui.read_masked",
        "risk": "low",
        "purpose": "读取当前页面掩码摘要，帮用户记录所见内容"
      },
      {
        "capability": "agent.memory.own",
        "risk": "medium",
        "purpose": "读写自身记忆分区，保存用户授权的便签"
      },
      {
        "capability": "events.read",
        "risk": "low",
        "purpose": "订阅通知 posted 事件用于提醒",
        "types": ["notification.posted"]
      }
    ],
    "memory_scope": "own_only",
    "network_domains": ["api.example.com"],
    "budgets": {
      "cost_per_day_usd": 0.05,
      "max_walltime_ms_per_task": 30000,
      "max_calls_per_hour": 50
    },
    "capability_ttl_ms": 86400000,
    "sandbox_resources": {
      "cpu_percent": 5,
      "memory_mb": 128
    }
  }
}
