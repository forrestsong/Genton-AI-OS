<?xml version="1.0" encoding="utf-8"?>
<!-- AI Native OS - SystemUI Manifest -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.systemui.genton"
    android:sharedUserId="android.uid.system">

    <!-- 权限声明 -->
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".GentonSystemUIApplication"
        android:label="AI Native SystemUI"
        android:persistent="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!-- 主Activity -->
        <activity
            android:name=".GentonSystemUIActivity"
            android:label="AI Native OS"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.genton.ACTION_SHOW_ASSISTANT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 入口服务（D1.2）：悬浮球/侧边手势/QS Tile -->
        <service
            android:name=".entry.FloatingButtonService"
            android:label="Assistant Floating Button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false" />

        <!-- QS Tile -->
        <service
            android:name=".entry.AssistantQSTile"
            android:label="AI Assistant"
            android:icon="@android:drawable/ic_dialog_info"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
