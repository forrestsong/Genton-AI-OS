# AI Native OS SELinux 大脑应用域定义
#
# 定义 Agent 大脑特权应用的 SELinux 域及其权限
#
# 版本: v1.0
# 日期: 2026-09-05
# 依据: WBS A1.4 权限清单落地

# ========================================
# 大脑应用域定义
# ========================================

# 定义 ainative_brain 域
type ainative_brain, domain;

# 标记为平台签名应用
typeattribute ainative_brain platformappdomain;

# 标记为特权应用
typeattribute ainative_brain priv_app;

# ========================================
# 服务发现权限
# ========================================

# 允许大脑查找所有 AI Native 服务
allow ainative_brain ainative_ui_tree_service:service_manager find;
allow ainative_brain ainative_screen_service:service_manager find;
allow ainative_brain ainative_notification_service:service_manager find;
allow ainative_brain ainative_event_stream_service:service_manager find;
allow ainative_brain ainative_action_service:service_manager find;
allow ainative_brain ainative_agent_runtime_service:service_manager find;
allow ainative_brain ainative_memory_service:service_manager find;
allow ainative_brain ainative_audit_service:service_manager find;
allow ainative_brain ainative_entity_service:service_manager find;
allow ainative_brain ainative_context_service:service_manager find;
allow ainative_brain ainative_policy_engine_service:service_manager find;
allow ainative_brain ainative_asset_library_service:service_manager find;
allow ainative_brain ainative_inference_router_service:service_manager find;
allow ainative_brain ainative_sandbox_service:service_manager find;
allow ainative_brain ainative_call_gate_service:service_manager find;
allow ainative_brain ainative_motion_hub_service:service_manager find;

# ========================================
# Binder 调用权限
# ========================================

# 允许大脑通过 Binder 调用所有 AI Native 服务
allow ainative_brain system_server:binder call;
binder_call(ainative_brain, system_server)

# ========================================
# 会话服务注册权限 (大脑作为服务提供方)
# ========================================

# 允许大脑注册会话服务供 SystemUI 调用
allow ainative_brain ainative_agent_session_service:service_manager add;
allow ainative_brain system_server:binder transfer;

# 允许 SystemUI 调用大脑的会话服务
binder_call(system_server, ainative_brain)

# ========================================
# 数据访问权限
# ========================================

# 允许访问 AI Native 数据目录
type ainative_data_file, file_type, data_file_type, core_data_file_type;
allow ainative_brain ainative_data_file:dir create_dir_perms;
allow ainative_brain ainative_data_file:file create_file_perms;

# 允许访问审计日志 (只读)
allow ainative_brain ainative_audit_service:file r_file_perms;

# ========================================
# 网络权限 (推理路由需要)
# ========================================

# 允许网络访问 (用于云端推理路由)
allow ainative_brain self:tcp_socket create_stream_socket_perms;
allow ainative_brain port:tcp_socket { name_bind name_connect };

# ========================================
# NPU/GPU 访问权限 (本地推理需要)
# ========================================

# 允许访问 NPU 设备
allow ainative_brain gpu_device:chr_file rw_file_perms;
allow ainative_brain gpu_device:dir search;

# ========================================
# 文件系统权限
# ========================================

# 允许读取系统配置
allow ainative_brain system_file:dir r_dir_perms;
allow ainative_brain system_file:file r_file_perms;

# 允许读取 AIDL 框架库
allow ainative_brain system_lib_file:dir r_dir_perms;
allow ainative_brain system_lib_file:file { read open getattr execute };

# ========================================
# SELinux 标签转换
# ========================================

# 大脑应用数据目录标签
type_transition ainative_brain system_data_file:dir ainative_data_file;
