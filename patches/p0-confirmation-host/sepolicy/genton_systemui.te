# AI Native OS SELinux SystemUI 扩展策略
#
# 扩展 SystemUI 权限以支持 AI Native 功能
#
# 版本: v1.0
# 日期: 2026-09-05
# 依据: WBS A1.4 权限清单落地

# ========================================
# 服务发现权限
# ========================================

# 允许 SystemUI 查找 AI Native UI 相关服务
allow system_app genton_context_service:service_manager find;
allow system_app genton_audit_service:service_manager find;

# 允许 SystemUI 查找大脑的会话服务
allow system_app genton_agent_session_service:service_manager find;

# ========================================
# Binder 调用权限
# ========================================

# 允许 SystemUI 调用大脑的会话服务
# [主线2修复] 引用已停用域 genton_brain
# binder_call(system_app, genton_brain)

# 允许 SystemUI 调用 system_server 中的 AI Native 服务
binder_call(system_app, system_server)

# ========================================
# Agent UI 服务注册权限
# ========================================

# 允许 SystemUI 注册 IAgentAssistantUi 服务供大脑回调
allow system_app genton_agent_ui_service:service_manager add;

# 允许大脑调用 SystemUI 的 UI 命令接口
# [主线2修复] 引用已停用域 genton_brain
# binder_call(genton_brain, system_app)

# ========================================
# 数据访问权限
# ========================================

# 允许 SystemUI 读取审计日志 (用于仪表盘展示)
# [主线2修复] 引用未定义类型 genton_data_file
# allow system_app genton_data_file:dir r_dir_perms;
# [主线2修复] 引用未定义类型 genton_data_file
# allow system_app genton_data_file:file r_file_perms;

# ========================================
# [P0] 确认宿主服务（SystemUI 注册）
# ========================================
# 按 D5 §5.1：确认面板由 SystemUI 独占实现并反向注册，执行层/策略引擎调用它
allow system_app genton_confirmation_host_service:service_manager add;
# SystemUI 需查找策略引擎以回灌用户决策（reportUserDecision）
allow system_app genton_policy_engine_service:service_manager find;
# [P0] SystemUI 需查找确认宿主以反向注册 UI 提供方
allow system_app genton_confirmation_host_service:service_manager find;
