# AI Native OS - SELinux 属性定义
# 定义新的安全属性

# AI Native OS 服务域属性
attribute genton_domain;

# 添加所有服务到该属性
typeattribute genton_service genton_domain;
typeattribute genton_audit genton_domain;
typeattribute genton_policy genton_domain;
typeattribute genton_inference genton_domain;
typeattribute genton_call genton_domain;
typeattribute genton_motion genton_domain;

# AI Native OS 数据文件属性
attribute genton_data_file_type;
typeattribute genton_audit_data_file genton_data_file_type;
typeattribute genton_policy_data_file genton_data_file_type;
typeattribute genton_brain_app_data_file genton_data_file_type;
