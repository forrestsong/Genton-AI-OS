# ============================================================
# Genton — .gitignore
# 仅保留核心代码与配置，排除所有过程文档、测试脚本、日志、密钥、临时文件
# ============================================================

# ---------- 目录级排除 ----------
# 过程文档与报告
reports/
docs/

# 日志与构建产物
logs/
artifacts/
out/
dist/
build/

# 密钥与签名文件（安全红线：私钥绝不入库）
keys/
*.keystore
*.jks
*.p12
*.pfx

# 商业文档
商业计划书/

# 临时代码快照
tree_snapshot/
tree_snapshot_fixed/

# 过程工具脚本目录
emulator_scripts/
ops_scripts/
port_scripts/
build_scripts/
audit_scripts/
scripts/

# 测试用例目录
tests/

# 缓存与下载
downloads/
android-sdk/
temp_*/
tmp/
cache/

# 模型权重（大文件，独立分发）
NeoHorse-Jev-4B/

# ACL 修复临时目录（本会话产物，非项目内容）
_acl_recovery/
.dsh-acl-recovery/
.dsh-acl-reports/
.dsh-write-test.tmp

# ---------- 根目录过程文件（全部排除，仅保留 README 和 LICENSE） ----------
# 根目录所有 Markdown 文档（保留 README.md 和 README.en.md）
/*.md
!/README.md
!/README.en.md

# 根目录所有 shell 脚本
/*.sh

# 根目录所有 Python 脚本
/*.py

# 根目录所有 PowerShell / batch 脚本
/*.ps1
/*.bat

# 根目录所有 Makefile / mk 配置
/*.mk
/*.bp

# 根目录所有图片
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# 根目录其他过程文件
/*.txt
wget-log

# ---------- tools/ 内部排除：测试脚本（保留 verification 下的安全门禁脚本） ----------
tools/test_*.py

# ---------- 语言通用缓存 ----------
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# Java/Kotlin
*.class
*.dex
*.jar
*.apk
*.ap_
*.aab
*.idsig
*.o
*.so

# Kotlin
*.kotlin_module

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
